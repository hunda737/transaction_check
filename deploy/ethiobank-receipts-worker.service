# /etc/systemd/system/ethiobank-receipts-worker.service
#
# The bank worker: drains POST /verifications jobs at a rate each bank
# tolerates and sends webhooks. Run exactly ONE instance -- the rate limiter
# lives in this process. Generated by deploy/install-service.sh.
[Unit]
Description=Ethiopian Bank Receipt Service (bank worker)
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=YOUR_USER
Group=YOUR_USER
WorkingDirectory=/home/YOUR_USER/transaction_check
EnvironmentFile=/home/YOUR_USER/transaction_check/.env
Environment=ETHIOBANK_DB_PATH=/home/YOUR_USER/transaction_check/data/ethiobank.db

ExecStart=/home/YOUR_USER/transaction_check/.venv/bin/python -m ethiobank_receipts.worker

Restart=always
RestartSec=5
# Let an in-flight bank call (<= ~40s) finish; unfinished jobs are re-queued
# on the next start anyway.
TimeoutStopSec=60

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=false
ReadWritePaths=/home/YOUR_USER/transaction_check/data
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
